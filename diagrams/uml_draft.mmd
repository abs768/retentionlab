%% RetentionLab: Phase 1 design (analytical pipeline only, commit fa3fc9d).
%% Modules are drawn as <<module>> boxes listing their public functions;
%% real classes (DataSplits, PipelineResult) list their fields.
classDiagram
    direction TB

    class config {
        <<module>>
        RANDOM_SEED = 42
        TEST_SIZE = 0.15
        VALIDATION_SIZE = 0.15
        CALIBRATION_METHODS
        POLICY_CAPACITY_FRACTIONS
        EXPERIMENT_ABSOLUTE_REDUCTIONS
        CHI_SQUARE_FEATURES
    }

    class validation {
        <<module>>
        +validate_raw_dataframe(df) dict
        +save_validation_report(report, path) Path
    }

    class data {
        <<module>>
        +load_raw_data(path) DataFrame
        +coerce_numeric_columns(df, columns) DataFrame
        +encode_target(df) DataFrame
        +prepare_dataset(df) DataFrame
        +split_features_target(df) tuple
        +make_splits(df, test_size, validation_size, random_state) DataSplits
    }

    class DataSplits {
        <<NamedTuple>>
        X_train: DataFrame
        X_val: DataFrame
        X_test: DataFrame
        y_train: Series
        y_val: Series
        y_test: Series
    }

    class features {
        <<module>>
        +infer_feature_types(X) tuple
        +build_linear_preprocessor(num, cat) ColumnTransformer
        +build_tree_preprocessor(num, cat) ColumnTransformer
    }

    class models {
        <<module>>
        +build_baseline_model(num, cat) Pipeline
        +build_challenger_model(num, cat) Pipeline
        +build_candidate_models(X_train) dict
        +build_calibrated_model(base_model, method, cv) CalibratedClassifierCV
    }

    class evaluation {
        <<module>>
        +compute_metrics(y_true, y_prob, threshold) dict
        +plot_roc_curve(y_true, y_prob, path) Path
        +plot_precision_recall_curve(y_true, y_prob, path) Path
        +plot_calibration_curve(curves, path) Path
        +plot_confusion_matrix(y_true, y_prob, path) Path
    }

    class policy {
        <<module>>
        +evaluate_policy(y_true, y_prob, capacity_fraction) dict
        +evaluate_policies(y_true, y_prob) DataFrame
        +cumulative_gains(y_true, y_prob) DataFrame
        +plot_cumulative_gains(y_true, y_prob, path) Path
    }

    class experimentation {
        <<module>>
        +required_sample_size_per_arm(baseline_rate, absolute_reduction, power) int
        +minimum_detectable_effect(baseline_rate, n_per_arm, power) dict
        +build_experiment_design_table(baseline_rate) DataFrame
    }

    class inference {
        <<module>>
        +cramers_v(contingency, chi2) float
        +chi_square_test(df, feature) dict
        +run_chi_square_suite(df, features) tuple
    }

    class reporting {
        <<module>>
        +count_collected_tests() int
        +write_resume_facts(summary, ..., path) Path
    }

    class pipeline {
        <<module>>
        +train_and_compare_models(splits) tuple
        +select_model(validation_metrics) str
        +choose_calibration(base_model, splits) tuple
        +evaluate_on_test(model, splits) tuple
        +run_pipeline(raw_path) PipelineResult
    }

    class PipelineResult {
        <<dataclass>>
        validation_report: dict
        split_sizes: dict
        validation_metrics: DataFrame
        selected_model_name: str
        calibration_choice: str
        test_metrics: dict
        policy_table: DataFrame
        experiment_table: DataFrame
        chi_square_summary: DataFrame
        artifacts: dict
    }

    data ..> config : reads constants
    data --> DataSplits : creates
    models ..> features : builds preprocessors
    pipeline ..> validation : 1. validate
    pipeline ..> data : 2. prepare and split
    pipeline ..> models : 3. train and calibrate
    pipeline ..> evaluation : 4. score test once
    pipeline ..> policy : 5. capacity policy
    pipeline ..> experimentation : 6. size an RCT
    pipeline ..> inference : 7. chi-square tests
    pipeline ..> reporting : 8. resume facts
    pipeline --> PipelineResult : returns
